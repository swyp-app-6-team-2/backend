# starpick VM 환경변수 예시
#
# 키가 아예 없으면 앱이 기동에 실패한다. 반면 값만 빈 줄(KEY=)은 빈 문자열로 주입돼
# 조용히 기동하므로, 채운 뒤 deploy/check-env.sh 로 확인하고 앱을 다시 올린다.
#   docker compose -p swyp-backend --env-file .env.vm -f docker-compose.vm.yml up -d app

# ──────────────────────────────────────────────────────────────
# 배포
# compose 프로젝트명은 고정한다. 바뀌면 다른 볼륨에 붙어 빈 DB 로 기동한다.

# [필수]
COMPOSE_PROJECT_NAME=swyp-backend

# [필수] 배포할 때마다 CD 가 갱신한다. 수동 기동 시 이 값이 쓰인다.
APP_IMAGE=

# [필수] Caddy 가 인증서를 발급받는 도메인. dev-api.starpick.cloud / api.starpick.cloud
# 비면 Caddy 기동이 실패해 80·443 이 통째로 죽는다.
API_DOMAIN=

# ──────────────────────────────────────────────────────────────
# 데이터베이스

# [필수]
POSTGRES_DB=starpick

# [필수]
POSTGRES_USER=starpick

# [필수] 여기만 바꿔선 반영되지 않는다. DB 에 ALTER USER 를 먼저 실행한다.
POSTGRES_PASSWORD=

# ──────────────────────────────────────────────────────────────
# 인증

# [필수] 바꾸면 발급된 토큰이 전부 무효가 된다. dev 와 prod 는 다른 값을 쓴다.
JWT_SECRET=

# [필수]
GOOGLE_CLIENT_ID=

# [필수]
KAKAO_APP_ID=

# [필수] 네이버 개발자센터 애플리케이션의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [필수]
APPLE_CLIENT_ID=

# ──────────────────────────────────────────────────────────────
# 저장소·이미지

# [필수] starpick-dev-images / starpick-prod-images
GCS_BUCKET=

# [필수] 앱이 /images/** 로 아이콘을 서빙한다. API_DOMAIN 과 같은 주소를 적는다.
INGREDIENT_ICON_BASE_URL=

# [필수] DB 덤프를 올릴 버킷. starpick-dev-backups / starpick-prod-backups
BACKUP_BUCKET=

# [필수] .env.vm 사본을 올릴 버킷. starpick-dev-secrets / starpick-prod-secrets
SECRETS_BUCKET=

# ──────────────────────────────────────────────────────────────
# 외부 분석
# 비우면 해당 기능만 꺼진다. 기동은 정상이다.

# [선택] 비우면 Ingestion Worker 를 맡지 않는다.
GEMINI_API_KEY=

# [선택] GEMINI_API_KEY 와 함께 채운다. 하나만 채우면 기동에 실패한다.
YOUTUBE_API_KEY=

# [선택] Instagram 보조 수집. 비우면 보조 수집을 하지 않는다.
APIFY_TOKEN=

# ──────────────────────────────────────────────────────────────
# 알림
# 비우면 해당 알림만 꺼진다.

# [선택] 비우면 알림 Worker 를 맡지 않는다.
FCM_PROJECT_ID=

# [선택]
NOTIFICATION_MEAL_BODY=

# [선택]
NOTIFICATION_DEEP_LINK=

# [선택] 문의 접수 알림을 받을 Discord 웹훅.
INQUIRY_DISCORD_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────
# 광고
# 비밀값이 아니다. 앱 바이너리에 그대로 들어가는 공개 식별자다.

# [필수]
ADMOB_AD_UNIT_ANDROID=

# [선택]
ADMOB_AD_UNIT_IOS=

# ──────────────────────────────────────────────────────────────
# 관리자 페이지
# /admin 로그인 계정. 특수문자를 넣지 않는다 — compose 가 $ 를 치환하고
# Spring 이 ${ 를 다시 해석해 값이 조용히 잘린다.

# [필수]
ADMIN_USERNAME=

# [필수]
ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# 개발 편의
#
# application.yml 의 springdoc 기본값은 "꺼짐"이다. 비워두면 prod 에서
# /swagger-ui/**, /v3/api-docs/** 가 닫힌다 — 그게 의도한 기본값이다.
# dev 는 Swagger 를 쓰므로 두 값을 true 로 채운다. 비워두면 조용히 닫힌다.

# [dev 권장 true / prod 비움]
SPRINGDOC_APIDOCS_ENABLED=

# [dev 권장 true / prod 비움]
SPRINGDOC_SWAGGERUI_ENABLED=
