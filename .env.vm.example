POSTGRES_DB=starpick
POSTGRES_USER=starpick
POSTGRES_PASSWORD=
JWT_SECRET=
APP_IMAGE=
GOOGLE_CLIENT_ID=
KAKAO_APP_ID=
APPLE_CLIENT_ID=
GCS_BUCKET=starpick-dev-images
# 둘을 함께 채운다. GEMINI_API_KEY 만 채우고 YOUTUBE_API_KEY 를 비우면 앱이 기동에 실패한다
GEMINI_API_KEY=
YOUTUBE_API_KEY=
# 앱이 /images/** 로 아이콘을 직접 서빙한다. 외부에서 보이는 주소를 적는다
INGREDIENT_ICON_BASE_URL=https://dev-api.starpick.cloud
# 셋을 함께 채운다. FCM_PROJECT_ID 만 채우고 나머지를 비우면 앱이 기동에 실패한다
FCM_PROJECT_ID=
NOTIFICATION_MEAL_BODY=
NOTIFICATION_DEEP_LINK=
# 관리자 페이지(/admin) 계정. 비밀번호는 `openssl rand -hex 32` 결과(64자)를 쓴다.
# compose 가 따옴표 없는 값의 $ 를 치환하고 Spring 이 ${·#{ 를 다시 해석해 조용히 잘리므로 특수문자를 넣지 않는다
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 문의 접수 알림을 받을 Discord 채널의 웹훅 주소. 비우면 알림을 보내지 않는다(기동은 정상)
INQUIRY_DISCORD_WEBHOOK_URL=
# AdMob 보상형 광고 단위. 비밀값이 아니라 앱 바이너리에 그대로 들어가는 공개 식별자다.
# ANDROID 를 비우면 기동이 실패한다(ad-reward.android.ad-unit-id 가 필수값). IOS 는 준비 전까지 비워도 된다.
ADMOB_AD_UNIT_ANDROID=
ADMOB_AD_UNIT_IOS=
