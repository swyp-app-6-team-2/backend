{
  "uid": "starpick-deep",
  "title": "StarPick Backend Deep",
  "tags": [
    "starpick"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(up, env)",
          "refId": "var"
        },
        "refresh": 1,
        "includeAll": false,
        "current": {
          "text": "dev",
          "value": "dev"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "⏱ 요청 지연",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 18,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "응답시간 p95 / p99 (uri 별)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "http_server_requests_seconds{env=\"$env\", quantile=\"0.95\"}",
          "legendFormat": "{{uri}} p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "http_server_requests_seconds{env=\"$env\", quantile=\"0.99\"}",
          "legendFormat": "{{uri}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "클라이언트 측 백분위(application.yml management.metrics.distribution.percentiles)다. 태그 조합별 값이라 합산·평균이 성립하지 않는다 — uri 별로만 읽는다."
    },
    {
      "type": "timeseries",
      "title": "응답시간 평균 (uri 별)",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{env=\"$env\"}[1m])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{env=\"$env\"}[1m])), 0.001)",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "RPS (uri 별, 1분 창)",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{env=\"$env\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "동시 처리 중 요청",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(http_server_requests_active_seconds_count{env=\"$env\"})",
          "legendFormat": "in-flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "active 지표의 uri 는 구조적으로 UNKNOWN(요청 시작 시점에 핸들러가 정해지지 않음)이라 총량만 볼 수 있다."
    },
    {
      "type": "row",
      "title": "🧵 JVM · 스레드",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 23,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tomcat 스레드 풀",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "tomcat_threads_busy_threads{env=\"$env\"}",
          "legendFormat": "{{name}} busy"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "tomcat_threads_current_threads{env=\"$env\"}",
          "legendFormat": "{{name}} current"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "tomcat_threads_config_max_threads{env=\"$env\"}",
          "legendFormat": "{{name}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "server.tomcat.mbeanregistry.enabled=true 가 있어야 나온다(로컬 실측: name=\"http-nio-8080\" 만 나오고 관리 포트 커넥터는 잡히지 않는다). config max 는 200 이고, busy 가 거기에 붙으면 요청이 큐에서 대기하기 시작한다."
    },
    {
      "type": "timeseries",
      "title": "JVM Heap used vs max",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{env=\"$env\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(jvm_memory_max_bytes{env=\"$env\", area=\"heap\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "GC 정지 시간 / 초",
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (cause) (rate(jvm_gc_pause_seconds_sum{env=\"$env\"}[1m]))",
          "legendFormat": "{{cause}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM 스레드",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "jvm_threads_live_threads{env=\"$env\"}",
          "legendFormat": "live"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "jvm_threads_daemon_threads{env=\"$env\"}",
          "legendFormat": "daemon"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "row",
      "title": "🗄 DB · 의존 · 배경 작업",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 28,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션 풀 (상세)",
      "id": 29,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_active{env=\"$env\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_idle{env=\"$env\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_pending{env=\"$env\"}",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_max{env=\"$env\"}",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "커넥션 획득 시간 (최대)",
      "id": 30,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_acquire_seconds_max{env=\"$env\"}",
          "legendFormat": "획득 시간"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "0보다 커지면 요청이 풀을 기다리고 있다는 뜻이다. 부하 시 DB 가 병목인지 판단하는 첫 지표."
    },
    {
      "type": "timeseries",
      "title": "외부 호출 지연",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (client_name) (rate(http_client_requests_seconds_sum{env=\"$env\"}[1m])) / clamp_min(sum by (client_name) (rate(http_client_requests_seconds_count{env=\"$env\"}[1m])), 0.001)",
          "legendFormat": "{{client_name}} 평균"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (client_name) (http_client_requests_seconds_max{env=\"$env\"})",
          "legendFormat": "{{client_name}} 최대"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "스케줄 작업 실행 시간 (최대)",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "label_replace(max by (code_namespace, code_function) (tasks_scheduled_execution_seconds_max{env=\"$env\"}), \"cls\", \"$1\", \"code_namespace\", \".*[.]([^.]+)\")",
          "legendFormat": "{{cls}}.{{code_function}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "Ingestion poll 이 느려지면 선점이 밀린다. 스케줄러 풀은 3개뿐이라 한 작업이 길어지면 나머지가 대기한다."
    }
  ],
  "description": "부하테스트·심층 진단용. 창은 전부 1분이고 갱신은 10초다. 상시 관측은 StarPick Backend Overview 를 쓴다."
}
