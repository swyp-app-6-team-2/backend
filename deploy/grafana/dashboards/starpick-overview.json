{
  "uid": "starpick-overview",
  "title": "StarPick Backend Overview",
  "tags": [
    "starpick"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(up, env)",
          "refId": "var"
        },
        "refresh": 1,
        "includeAll": false,
        "current": {
          "text": "dev",
          "value": "dev"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🎯 지금 정상인가",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "가동 시간",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "process_uptime_seconds{job=\"starpick/app\", env=\"$env\"}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 600
              }
            ]
          },
          "noValue": "다운"
        },
        "overrides": []
      },
      "description": "값이 없으면 스크랩이 끊긴 상태(앱 다운). 10분 미만이면 방금 재시작했다는 뜻이다."
    },
    {
      "type": "stat",
      "title": "Total RPS",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{env=\"$env\"}[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "다른 모든 지표 해석의 전제. 0이면 아래 지연·오류 수치는 의미가 없다."
    },
    {
      "type": "stat",
      "title": "5xx (5분)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{env=\"$env\", status=~\"5..\"}[5m])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "'5xx 급증' 알림과 같은 단위·임계(5분 5건). 비율은 트래픽이 적을 때 왜곡돼 쓰지 않는다."
    },
    {
      "type": "stat",
      "title": "JVM Heap %",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{env=\"$env\", area=\"heap\"}) / sum(jvm_memory_max_bytes{env=\"$env\", area=\"heap\"}) * 100"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "힙 상한은 컨테이너 2g × MaxRAMPercentage 50% = 약 1.0GB."
    },
    {
      "type": "row",
      "title": "📡 요청과 의존",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "RPS by Endpoint",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "uri=\"UNKNOWN\"은 인증 필터에서 막힌 401이다 — 핸들러 매핑 전에 끝나 경로를 알 수 없다."
    },
    {
      "type": "timeseries",
      "title": "Status Code Distribution",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "4xx 급증에는 알림이 없다. FE 계약 깨짐·토큰 폭주를 볼 유일한 창이다."
    },
    {
      "type": "timeseries",
      "title": "응답시간 — 평균 / 최대",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{env=\"$env\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{env=\"$env\"}[5m])), 0.001)",
          "legendFormat": "평균"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(http_server_requests_seconds_max{env=\"$env\"})",
          "legendFormat": "최대"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "엔드포인트별 지연과 p95 는 starpick-deep 에 있다."
    },
    {
      "type": "timeseries",
      "title": "외부 호출",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (client_name, outcome) (rate(http_client_requests_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "{{client_name}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "Gemini·YouTube·Apify·Instagram·Kakao 가 모두 주입된 RestClient.Builder 를 쓰므로 여기 잡힌다. 외부 의존 장애는 HTTP 200 + FAILED 로 나가 5xx 에 안 잡히므로 이 패널로 본다."
    },
    {
      "type": "row",
      "title": "⚙️ 배경 작업과 자원",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 11,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "스케줄 작업 실행 / 분",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "label_replace(sum by (code_namespace, code_function) (rate(tasks_scheduled_execution_seconds_count{env=\"$env\"}[5m])) * 60, \"cls\", \"$1\", \"code_namespace\", \".*[.]([^.]+)\")",
          "legendFormat": "{{cls}}.{{code_function}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "기대값: IngestionSchedule.poll 약 30/분(2초 주기), NotificationSchedule.run·requeueOrFailStale·failStuckQueued·UserWithdrawalSchedule.recover 각 1/분, 시간당 작업 3개는 5분 창에서 0.\npoll·run 두 계열은 「Ingestion Worker 정지」·「알림 Worker 정지」 알림이 감시한다(10분 0회 → 경보, 계열 소멸=Worker 미등록도 No Data 로 경보). 나머지 계열은 화면으로만 본다."
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션 풀",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_active{env=\"$env\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "hikaricp_connections_pending{env=\"$env\"}",
          "legendFormat": "pending ⚠"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "postgres exporter 가 없어 DB 포화를 볼 유일한 창이다. pending 이 0보다 크면 풀(기본 10) 고갈."
    },
    {
      "type": "timeseries",
      "title": "CPU Usage %",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{env=\"$env\", mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "node_memory_MemTotal_bytes{env=\"$env\"} - node_memory_MemAvailable_bytes{env=\"$env\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "node_memory_MemTotal_bytes{env=\"$env\"}",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "앱 컨테이너는 mem_limit 2g. 호스트가 차면 OOM kill 이 앱을 죽인다."
    },
    {
      "type": "timeseries",
      "title": "Disk Usage % (/)",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(1 - node_filesystem_avail_bytes{env=\"$env\", mountpoint=\"/\"} / node_filesystem_size_bytes{env=\"$env\", mountpoint=\"/\"}) * 100",
          "legendFormat": "/"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "80% 선은 '디스크 80% 초과' 알림과 같은 임계다. postgres 가 같은 디스크에 있어 차면 서비스와 관측이 함께 멈춘다."
    },
    {
      "type": "logs",
      "title": "앱 ERROR / WARN 로그",
      "id": 17,
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{container=\"starpick-vm-app\", env=\"$env\"} |~ \"ERROR|WARN\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "알림을 받고 들어왔을 때의 시작점. 전체 로그는 Explore 에서 container 라벨로 본다."
    }
  ],
  "description": "상시 운영 화면. 알림이 울렸을 때 원인을 좁히고, 알림이 없는 영역(4xx·의존·배경 작업)을 눈으로 본다. 부하테스트와 심층 진단은 StarPick Backend Deep 을 쓴다."
}
