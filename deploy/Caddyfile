{$API_DOMAIN} {
	# 액세스 로그. 앱이 §9 기준으로 일부러 로그에서 뺀 것을 프록시가 되넣지 않도록 걸러낸다.
	# 필터는 2026-09-19 에 버리는 컨테이너로 실제 출력까지 확인했다.
	#
	# wrap 을 console 로 바꾸지 말 것. Alloy 의 stage.multiline 이 "타임스탬프(하이픈) 또는 {" 로
	# 시작하는 줄만 새 줄로 보는데, console 은 2026/09/19 (슬래시) 로 찍어 연속된 요청이 한 덩어리로 합쳐진다.
	#
	# IP 는 마스킹하지 않는다. 알림(관리자 로그인 실패 급증)에 대응하려면 어느 IP 인지 알아야 하고,
	# 앱도 AdminLoginFailureHandler 에서 이미 전체 IP 를 남긴다. 보존기간(14일)과 접근 제한으로 관리한다.
	# 응답 헤더의 Set-Cookie 는 Caddy 가 REDACTED 로 바꾼다(실측).
	log {
		format filter {
			wrap json
			fields {
				# 쿼리스트링을 통째로 지운다. 경로만 남아도 어떤 API 가 불렸는지는 안다.
				# query 필터는 이름을 아는 파라미터만 지울 수 있어(delete * 는 아무것도 안 지움) regexp 를 쓴다.
				request>uri regexp "[?].*" ""
				# 요청 헤더는 통째로 지운다. Authorization·Cookie 만 지우면 Referer 의 쿼리처럼
				# 이름을 예측하지 못한 값이 남는다. 앱도 헤더를 통째로 제외한다.
				request>headers delete
			}
		}
	}

	reverse_proxy app:8080
}
